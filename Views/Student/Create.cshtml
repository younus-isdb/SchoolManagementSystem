@model SchoolManagementSystem.Models.Student

<div class="container mt-4">
    <h2 class="mb-4 fw-bold text-success">Student Admission Form</h2>

    <form asp-action="Create" method="post" class="row g-3">

        <!-- User Dropdown -->
        <div class="col-md-6">
            <label class="form-label fw-semibold">User Account</label>
            <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users"></select>
        </div>

        <!-- Class Dropdown -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Class</label>
            <select asp-for="ClassId" class="form-select" asp-items="ViewBag.Classes"></select>
        </div>

        <!-- Section Dropdown -->
        <div class="col-md-3">
            <label class="form-label fw-semibold">Section</label>
            <select asp-for="SectionId" class="form-select" asp-items="ViewBag.Sections"></select>
        </div>

        <!-- Roll No -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Roll Number</label>
            <input asp-for="RollNo" class="form-control" />
        </div>

        <!-- Gender -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Gender</label>
            <select asp-for="Gender" class="form-select">
                <option value="">-- Select --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <!-- Blood Group -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Blood Group</label>
            <input asp-for="BloodGroup" class="form-control" />
        </div>

        <!-- DOB -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Date of Birth</label>
            <input asp-for="DOB" type="date" class="form-control" />
        </div>

        <!-- Guardian Name -->
        <div class="col-md-8">
            <label class="form-label fw-semibold">Guardian Name</label>
            <input asp-for="GuardianName" class="form-control" />
        </div>

        <!-- Address -->
        <div class="col-12">
            <label class="form-label fw-semibold">Address</label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        </div>

        <!-- Admission Date -->
        <div class="col-md-4">
            <label class="form-label fw-semibold">Admission Date</label>
            <input asp-for="AdmissionDate" type="date" class="form-control" />
        </div>

        <!-- Submit -->
        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-success px-4 py-2 fw-bold">Submit Admission</button>
        </div>

    </form>
</div>
