@model SchoolManagementSystem.Models.Class
@{
    ViewData["Title"] = "Class Details";
}

<h2>Class Details</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ClassId</dd>

            <dt class="col-sm-3">Class Name</dt>
            <dd class="col-sm-9">@Model.ClassName</dd>

            <dt class="col-sm-3">Session Year</dt>
            <dd class="col-sm-9">@Model.SessionYear</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department.DepartmentName</dd>

            <dt class="col-sm-3">Sections Count</dt>
            <dd class="col-sm-9">@Model.Sections.Count</dd>

            <dt class="col-sm-3">Students Count</dt>
            <dd class="col-sm-9">@Model.Students.Count</dd>

            <dt class="col-sm-3">Subjects Count</dt>
            <dd class="col-sm-9">@Model.Subjects.Count</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.ClassId" class="btn btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>
</div>
