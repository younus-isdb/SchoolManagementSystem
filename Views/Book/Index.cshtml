@model IEnumerable<SchoolManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">

    <div class="d-flex justify-content-center align-items-center mb-4 position-relative">
        <h2 class="text-dark mb-0 fw-bolder text-center">Book Inventory</h2>
        <a asp-action="Create" class="btn btn-success position-absolute end-0">
            <i class="fas fa-plus-circle me-2"></i>Add New Book
        </a>
    </div>
  

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-lg table-hover align-middle table-bordered ">
                    <thead class="table-success">
                        <tr>
                            <th class=" ps-4 fw-semibold text-dark">Cover</th>
                            <th class=" fw-semibold text-dark text-center">Title</th>
                            <th class=" fw-semibold text-dark text-center">Author</th>
                            <th class=" fw-semibold text-dark text-center">ISBN</th>
                            <th class=" fw-semibold text-dark text-center">Category</th>
                            <th class=" fw-semibold text-dark text-center">Total</th>
                            <th class=" fw-semibold text-dark text-center">Available</th>
                            <th class=" fw-semibold text-dark text-center ">Actions</th>
                        </tr>
                    </thead>
                    <tbody >
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var book in Model)
                            {
                                <tr >
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(book.ImageUrl))
                                        {
                                            <img src="@book.ImageUrl" alt="@book.Title"
                                                 class="img-thumbnail" style="width: 60px; height: 80px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center"
                                                 style="width: 60px; height: 80px;">
                                                <i class="fas fa-book text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="fw-medium text-dark">@book.Title</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="text-muted">@book.Author</div>
                                    </td>
                                    <td class="text-center">
                                        <code class="text-sm">@book.ISBN</code>
                                    </td>
                                    <td class="text-center">
                                        <span class=" bg-light text-dark ">@book.Category</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-dark">@book.TotalCopies</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                                            @book.AvailableCopies
                                        </span>
                                    </td>
                                    <td class="text-center ">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@book.BookId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Edit
                                            </a>
                                            <a asp-action="Details" asp-route-id="@book.BookId"
                                               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                View
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@book.BookId"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-books fa-3x mb-3 opacity-25"></i>
                                        <h4 class="text-muted">No Books Available</h4>
                                        <p class="mb-0">Start building your library collection</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="mt-3 text-end">
            <small class="text-muted">Total: @Model.Count() books</small>
        </div>
    }
</div>