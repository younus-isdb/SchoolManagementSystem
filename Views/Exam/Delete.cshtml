@model Exam

<h2>Delete Exam</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this exam?
</div>

<ul class="list-group mb-3">
    <li class="list-group-item"><strong>Name:</strong> @Model.Name</li>
    <li class="list-group-item"><strong>Class:</strong> @Model.Class.ClassName</li>
    <li class="list-group-item"><strong>Term:</strong> @Model.Term</li>
    <li class="list-group-item"><strong>Type:</strong> @Model.Type</li>
</ul>

<form asp-action="Delete">
    <input type="hidden" asp-for="ExamId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
