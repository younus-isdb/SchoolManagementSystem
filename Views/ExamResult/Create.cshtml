@model ExamResult

<h2>Add Exam Result</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ExamId" value="@ViewBag.ExamId" />

    <div class="mb-3">
        <label>Student</label>
        <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentId">
            <option value="">-- Select Student --</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Subject</label>
        <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectId">
            <option value="">-- Select Subject --</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Marks Obtained</label>
        <input asp-for="MarksObtained" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Grade</label>
        <input asp-for="Grade" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Remarks</label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" asp-route-examId="@ViewBag.ExamId" class="btn btn-secondary">Back</a>
</form>
