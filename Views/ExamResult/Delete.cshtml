@model ExamResult

<h2>Delete Result</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this result?
</div>

<ul class="list-group mb-3">
    <li class="list-group-item"><strong>Student:</strong> @Model.Student.StudentName</li>
    <li class="list-group-item"><strong>Subject:</strong> @Model.Subject.SubjectName</li>
    <li class="list-group-item"><strong>Marks:</strong> @Model.MarksObtained</li>
</ul>

<form asp-action="Delete">
    <input type="hidden" asp-for="ResultId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-examId="@Model.ExamId" class="btn btn-secondary">Cancel</a>
</form>
